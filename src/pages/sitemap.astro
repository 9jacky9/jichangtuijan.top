---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allBrands } from '../data/brands';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout
  title={`全站站点地图：34家机场评测与${guides.length}篇攻略索引｜机场推荐`}
  description={`机场推荐 (jichangtuijan.top) 全站 HTML 站点地图：直达比价工具、分类排行榜、常见问题、34家品牌评测页与${guides.length}篇攻略。`}
  canonicalPath="/sitemap/"
>
  <section style="padding: 2.25rem 0; background: var(--tp-bg-alt); border-bottom: 1px solid var(--tp-border);">
    <div class="tp-container">
      <nav aria-label="面包屑" style="font-size: 0.84rem; color: var(--tp-text-muted); margin-bottom: 0.75rem;">
        <a href="/">首页</a> &rsaquo; <span>全站 HTML 站点地图</span>
      </nav>
      <h1 style="font-size: 2rem; font-weight: 900; margin: 0;">全站导航索引与站点地图 (Sitemap)</h1>
      <p style="color: var(--tp-text-secondary); margin: 0.45rem 0 0;">
        搜索引擎 XML 索引地址：<a href="/sitemap-index.xml"><code>https://jichangtuijan.top/sitemap-index.xml</code></a> &nbsp;|&nbsp; RSS 订阅源：<a href="/rss.xml"><code>https://jichangtuijan.top/rss.xml</code></a>
      </p>
    </div>
  </section>

  <div class="tp-container" style="padding-top: 2.25rem; padding-bottom: 3.5rem;">
    <div class="tp-bento-card" style="margin-bottom: 2rem;">
      <h2 style="margin-top: 0; font-size: 1.35rem; font-weight: 800;">一、 核心导购与比价工具频道（9个主路由）</h2>
      <ul style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 0.75rem; list-style: none; padding: 0; margin: 0;">
        <li><a href="/" style="font-weight: 700;">🏠 首页 · 2026 机场推荐总榜</a></li>
        <li><a href="/ranking/" style="font-weight: 700;">🏆 2026 五大维度机场排行榜中心</a></li>
        <li><a href="/coupons/" style="font-weight: 700;">机场口令总表</a></li>
        <li><a href="/compare/" style="font-weight: 700;">📊 34家机场参数与每GB单价横向比价表</a></li>
        <li><a href="/guides/" style="font-weight: 700;">📖 省钱攻略与价格段横评专栏</a></li>
        <li><a href="/faq/" style="font-weight: 700;">❓ 机场常见问题 FAQ</a></li>
        <li><a href="/about/" style="font-weight: 700;">🛡️ 关于我们与评测标准</a></li>
        <li><a href="/privacy/" style="font-weight: 700;">🔒 隐私保护政策</a></li>
        <li><a href="/terms/" style="font-weight: 700;">⚖️ 服务条款与免责声明</a></li>
      </ul>
    </div>

    <div class="tp-bento-card" style="margin-bottom: 2rem;">
      <h2 style="margin-top: 0; font-size: 1.35rem; font-weight: 800;">二、 34 家主流专线品牌独立评测资料与比价页（共 {allBrands.length} 页）</h2>
      <ul style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 0.65rem; list-style: none; padding: 0; margin: 0;">
        {allBrands.map((b) => (
          <li>
            <a href={`/reviews/${b.id}/`} style="font-weight: 700;">
              #{b.rank} {b.name} 评测与比价
            </a>
            <span style="font-size: 0.78rem; color: var(--tp-text-muted);"> (¥{b.lowestMonthlyDiscounted}/月起)</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="tp-bento-card">
      <h2 style="margin-top: 0; font-size: 1.35rem; font-weight: 800;">三、 2026 原创省钱攻略与横评文章（共 {guides.length} 篇）</h2>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.65rem;">
        {guides.map((g) => (
          <li style="padding-bottom: 0.5rem; border-bottom: 1px dashed var(--tp-border);">
            <span class="tp-badge tp-badge-violet" style="margin-right: 0.5rem;">{g.data.category}</span>
            <a href={`/guides/${g.slug}/`} style="font-weight: 700;">{g.data.title}</a>
            <span style="font-size: 0.8rem; color: var(--tp-text-muted); margin-left: 0.5rem;">({g.data.pubDate})</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
