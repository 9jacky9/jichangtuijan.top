---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const categories = ['全部', '预算精算榜', '优惠码对比', '旗舰横评', '场景选择', '防坑课'];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://jichangtuijan.top/' },
    { '@type': 'ListItem', position: 2, name: '省钱攻略与价格段横评专栏', item: 'https://jichangtuijan.top/guides/' },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '2026 机场推荐省钱攻略与横评专栏',
  numberOfItems: guides.length,
  itemListElement: guides.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.data.title,
    url: `https://jichangtuijan.top/guides/${g.slug}/`,
  })),
};
---

<BaseLayout
  title="机场攻略专栏：入门、选购、价格与优惠码｜机场推荐"
  description="机场推荐攻略专栏：新手入门、靠谱选购清单、价格速查、优惠码排查、客户端导入与速度自测，按问题找答案，附每GB成本算法。"
  canonicalPath="/guides/"
  jsonLd={[breadcrumbSchema, itemListSchema]}
>
  <section style="padding: 2.5rem 0 1.75rem; background: var(--tp-bg-alt); border-bottom: 1px solid var(--tp-border);">
    <div class="tp-container">
      <nav aria-label="面包屑" style="font-size: 0.84rem; color: var(--tp-text-muted); margin-bottom: 0.85rem;">
        <a href="/">首页</a> &rsaquo; <span>省钱攻略与价格段横评专栏</span>
      </nav>
      <span class="tp-badge tp-badge-gold">📖 编辑整理的精算报告 · 共 {guides.length} 篇深度专栏</span>
      <h1 style="font-size: clamp(1.75rem, 3.2vw, 2.5rem); font-weight: 900; margin: 0.6rem 0 0.75rem;">
        2026 专线机场省钱攻略 & 价格段深度横评
      </h1>
      <p style="color: var(--tp-text-secondary); max-width: 820px; margin: 0 0 1.4rem; font-size: 1rem;">
        不讲空洞技术套话，每篇报告都为你算清<strong>折后月均价、每 GB 真实流量单价、首单立省金额与避坑取舍</strong>。点击下方分类标签或输入关键词快速检索：
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; justify-content: space-between;">
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;" id="guideCatBtns">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`tp-btn ${idx === 0 ? 'tp-btn-violet' : 'tp-btn-outline'} guide-cat-btn`}
              aria-pressed={idx === 0 ? 'true' : 'false'}
              data-cat={cat}
              style="padding: 0.45rem 0.95rem; font-size: 0.85rem;"
            >
              {cat}
            </button>
          ))}
        </div>

        <input
          type="search"
          id="guideSearchInput"
          placeholder="搜索攻略标题 / 品牌 / 预算..."
          style="padding: 0.55rem 0.95rem; border-radius: 999px; border: 1px solid var(--tp-border-strong); background: var(--tp-card); color: var(--tp-text); font-size: 0.88rem; min-width: 240px;"
        />
      </div>
    </div>
  </section>

  <div class="tp-container" style="padding-top: 2.25rem; padding-bottom: 3rem;">
    <div class="tp-grid-3" id="guidesGrid">
      {guides.map((g) => {
        const searchStr = `${g.data.title} ${g.data.description} ${g.data.category} ${g.data.tags.join(' ')} ${g.data.buyerVerdict}`.toLowerCase();
        return (
          <article
            class="tp-bento-card guide-item-card"
            data-cat={g.data.category}
            data-search={searchStr}
            style="display: flex; flex-direction: column; justify-content: space-between;"
          >
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
                <span class="tp-badge tp-badge-violet">{g.data.category}</span>
                <span style="font-size: 0.78rem; color: var(--tp-text-muted);">{g.data.readingTime} · {g.data.pubDate}</span>
              </div>

              <h2 style="font-size: 1.15rem; font-weight: 800; line-height: 1.45; margin: 0 0 0.65rem;">
                <a href={`/guides/${g.slug}/`} style="color: var(--tp-text);">{g.data.title}</a>
              </h2>

              <p style="font-size: 0.86rem; color: var(--tp-text-secondary); margin: 0 0 0.85rem;">
                {g.data.description}
              </p>

              <div style="background: var(--tp-bg-alt); padding: 0.65rem 0.8rem; border-radius: 8px; font-size: 0.8rem; color: var(--tp-text-secondary); margin-bottom: 1rem; border-left: 3px solid var(--tp-gold);">
                <strong style="color: var(--tp-gold);">💡 编辑结论：</strong>{g.data.buyerVerdict}
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.7rem; border-top: 1px dashed var(--tp-border); font-size: 0.84rem;">
              <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                {g.data.tags.slice(0, 2).map((t: string) => (
                  <span style="font-size: 0.74rem; color: var(--tp-text-muted); background: var(--tp-bg-alt); padding: 0.1rem 0.45rem; border-radius: 4px;">
                    #{t}
                  </span>
                ))}
              </div>
              <a href={`/guides/${g.slug}/`} style="font-weight: 800;">阅读完整报告 &rarr;</a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <div class="tp-container"><p id="guideCount" role="status" aria-live="polite">显示 33 篇文章</p><div id="guideEmpty" hidden><p>没有找到匹配文章，可以清空关键词并查看全部分类。</p><button id="guideReset" type="button" class="tp-btn tp-btn-violet">清空筛选</button></div></div>
  <script is:inline>
    (function () {
      var catBtns = Array.prototype.slice.call(document.querySelectorAll('.guide-cat-btn'));
      var searchInput = document.getElementById('guideSearchInput');
      var cards = Array.prototype.slice.call(document.querySelectorAll('.guide-item-card'));
      var activeCat = '全部';

      function filterGuides() {
        var kw = searchInput ? searchInput.value.trim().toLowerCase() : '';
        var count=0;
        cards.forEach(function (card) {
          var c = card.getAttribute('data-cat');
          var s = card.getAttribute('data-search') || '';
          var okCat = activeCat === '全部' || c === activeCat;
          var okKw = !kw || s.indexOf(kw) !== -1;
          card.style.display = okCat && okKw ? 'flex' : 'none'; if(okCat&&okKw)count++;
        });
        document.getElementById('guideCount').textContent='显示 '+count+' 篇文章';
        document.getElementById('guideEmpty').hidden=count!==0;
      }

      document.getElementById('guideReset').addEventListener('click',function(){searchInput.value='';catBtns[0].click();});
      catBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeCat = btn.getAttribute('data-cat') || '全部';
          catBtns.forEach(function (b) {
            b.setAttribute('aria-pressed','false'); b.classList.remove('tp-btn-violet');
            b.classList.add('tp-btn-outline');
          });
          btn.classList.remove('tp-btn-outline');
          btn.setAttribute('aria-pressed','true'); btn.classList.add('tp-btn-violet');
          filterGuides();
        });
      });

      if (searchInput) searchInput.addEventListener('input', filterGuides);
    })();
  </script>
</BaseLayout>
