---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ledger from '../../data/couponLedger.json';
---
<BaseLayout title="机场优惠码与适用条件：34家资料核对｜机场推荐" description="查看34个品牌的优惠资料，按月付、年付、首单和充值条件核对口令，复制优惠码后前往购买页确认金额。" canonicalPath="/coupons/">
<section class="tp-container" style="padding-top:2.5rem;padding-bottom:3rem"><span class="tp-badge tp-badge-rose">24个品牌 · 26个优惠口令</span><h1 class="tp-section-title" style="margin:1rem 0">先看条件，再领优惠。</h1><p>优惠资料核对：2026年11月1日。这里核对的是提供的优惠资料，不表示已完成实时结算验证。首单、周期、充值与叠加条件请逐项确认；未提供优惠码的品牌不编造口令。</p><nav style="display:flex;flex-wrap:wrap;gap:1rem;margin:1.5rem 0"><a href="#zone-70">资料标注7折</a><a href="#zone-80">8折与周期优惠</a><a href="#zone-85">其他口令</a><a href="#zone-cycle">未提供口令</a></nav>{[{id:'zone-70',title:'资料明确的7折优惠',filter:(o:any)=>o.offers.some((c:any)=>c.rate===.7)},{id:'zone-80',title:'8折及按周期区分的优惠',filter:(o:any)=>!o.offers.some((c:any)=>c.rate===.7)&&o.offers.some((c:any)=>c.rate===.8)},{id:'zone-85',title:'其他折扣及待结算确认的口令',filter:(o:any)=>o.offers.length&&!o.offers.some((c:any)=>c.rate===.7||c.rate===.8)},{id:'zone-cycle',title:'资料未提供优惠口令的品牌',filter:(o:any)=>!o.offers.length}].map(group=><section id={group.id} style="padding-top:2rem"><h2 class="tp-section-title">{group.title}</h2><div class="tp-grid-2">{ledger.filter(group.filter).map(o=><article class="tp-bento-card"><h3><a href={'/reviews/'+o.id+'/'}>{o.name}</a></h3>{o.offers.length?o.offers.map(c=><div style="padding:1rem 0;border-bottom:1px solid var(--tp-border)"><p><strong style="color:var(--tp-rose);font-size:1.2rem">{c.code}</strong> · {c.rate?c.rate*10+'折':'折扣未注明'}</p><p>{c.condition}</p><button type="button" class="tp-btn tp-btn-outline" data-copy-offer={c.code}>复制 {c.code}</button></div>):<p>未提供公开优惠码，直接查看结算页活动。</p>}<a class="tp-btn tp-btn-rose" style="margin-top:1rem" href={o.url} target="_blank" rel="sponsored nofollow noopener">前往购买页核对 ↗</a></article>)}</div></section>)}<p id="coupon-status" role="status" aria-live="polite"></p></section><script is:inline>document.querySelectorAll('[data-copy-offer]').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.dataset.copyOffer);document.getElementById('coupon-status').textContent='已复制 '+b.dataset.copyOffer+'，请核对适用条件。';b.textContent='已复制 '+b.dataset.copyOffer;}catch{document.getElementById('coupon-status').textContent='自动复制不可用，请长按或选中口令复制：'+b.dataset.copyOffer;}}));</script></BaseLayout>